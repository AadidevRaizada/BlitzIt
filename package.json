{
  "name": "blitz-it",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "seed:problems": "tsx scripts/seed-problems.ts",
    "verify:problems": "tsx --conditions=react-server scripts/verify-problems.ts",
    "verify:contrast": "tsx scripts/verify-contrast.ts",
    "verify:runner": "tsx --conditions=react-server scripts/verify-runner.ts",
    "verify:queue": "tsx --conditions=react-server scripts/verify-queue.ts",
    "verify:auth": "tsx --conditions=react-server scripts/verify-auth.ts",
    "make:admin": "tsx --conditions=react-server scripts/make-admin.ts",
    "postinstall": "prisma generate",
    "prepare": "husky || true",
    "dev:session": "tsx --conditions=react-server scripts/dev-session.ts",
    "verify:evaluation": "tsx --conditions=react-server scripts/verify-evaluation.ts",
    "verify:evaluation:e2e": "tsx --conditions=react-server scripts/verify-evaluation-e2e.ts",
    "verify:admin": "tsx --conditions=react-server scripts/verify-admin.ts",
    "verify:llm": "tsx --conditions=react-server scripts/verify-llm.ts",
    "verify:profiles": "tsx --conditions=react-server scripts/verify-profiles.ts",
    "verify:tournament": "tsx --conditions=react-server scripts/verify-tournament.ts",
    "verify:bracket": "tsx --conditions=react-server scripts/verify-bracket.ts",
    "verify:tournament:e2e": "tsx --conditions=react-server scripts/verify-tournament-e2e.ts",
    "verify:submission": "tsx --conditions=react-server scripts/verify-submission.ts",
    "verify:payments": "tsx --conditions=react-server scripts/verify-payments.ts",
    "verify:prize-pool": "tsx --conditions=react-server scripts/verify-prize-pool.ts",
    "verify:sudden-death": "tsx --conditions=react-server scripts/verify-sudden-death.ts",
    "verify:live-arena": "tsx --conditions=react-server scripts/verify-live-arena.ts",
    "verify:spectator": "tsx --conditions=react-server scripts/verify-spectator.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.0.0",
    "animejs": "^4.5.0",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.462.0",
    "next": "^15.1.0",
    "next-themes": "^0.4.4",
    "pino": "^9.5.0",
    "posthog-js": "^1.200.0",
    "posthog-node": "^4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.18.0",
    "server-only": "^0.0.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "undici": "^7.29.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,mjs,json,css}": [
      "prettier --write"
    ]
  }
}
