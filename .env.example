# ─────────────────────────────────────────────────────────────
# Blitz It — environment variables
# Copy to .env and fill in. NEVER commit real secrets.
# Validated at boot by src/lib/env.ts (fails fast if missing/invalid).
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
# Public base URL of the app (used for auth callbacks, absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL) — Prisma 7 reads this via prisma.config.ts
DATABASE_URL=postgresql://user:password@localhost:5432/blitzit?schema=public

# Auth (Better Auth) — added in Sprint 1 / Epic E1
BETTER_AUTH_SECRET=replace-with-32+char-random-string
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payments (Razorpay) — Epic E4
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# AI evaluator (Epic E2) — Claude primary, OpenAI fallback (D18)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# GitHub (read repos as text via API — D1/D16) — Epic E2
GITHUB_API_TOKEN=

# Email (Resend) — Epic E8
RESEND_API_KEY=
EMAIL_FROM=noreply@blitzit.example

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=

# Monitoring (Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Evaluation runner
# Max concurrent evaluation jobs the in-process runner will claim.
RUNNER_CONCURRENCY=2
# Set to "false" to disable the in-process runner (e.g. in CI).
RUNNER_ENABLED=true
