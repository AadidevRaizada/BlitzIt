# ─────────────────────────────────────────────────────────────
# Blitz It — environment variables
# Copy to .env and fill in. NEVER commit real secrets.
# Validated at boot by src/lib/env.ts (fails fast if missing/invalid).
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
# Public base URL of the app (used for auth callbacks, absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL) — Prisma 7 reads this via prisma.config.ts
# Local dev: matches docker-compose.yml (run `docker compose up -d`).
# Host port 5434 avoids colliding with any Postgres already on 5432.
DATABASE_URL=postgresql://blitzit:blitzit@localhost:5434/blitzit?schema=public

# Auth (Better Auth) — added in Sprint 1 / Epic E1
BETTER_AUTH_SECRET=replace-with-32+char-random-string
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payments (Razorpay) — Epic E4
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── AI evaluator (Epic E2) ───────────────────────────────────────────────
# The LLM backend is fully configurable. Switching providers requires ONLY
# changing LLM_PROVIDER + LLM_MODEL — never a code change.
#
# OPTIONAL overall: with no key the AI dimension degrades to a neutral 50 and
# the evaluation still completes (functional/performance/security unaffected).
LLM_PROVIDER=openai          # openai | anthropic
LLM_MODEL=gpt-5.5            # e.g. gpt-5.5 | claude-sonnet-4-5
LLM_TEMPERATURE=0            # 0 for reproducible scoring (see note below)

# NOTE: OpenAI's gpt-5.x reasoning models only accept their default
# temperature (1) and reject a custom value. The provider detects this, omits
# the parameter, and records `temperatureApplied` in the evaluation audit so
# the evidence stays truthful. Use a non-reasoning model if you need temp 0.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub (read repos as TEXT via the API — never cloned — D1/D16) — Epic E2.
# STRONGLY RECOMMENDED (effectively required for a live event).
# Unauthenticated GitHub allows only 60 requests/hour. A single evaluation
# spends ~2 + N requests (N = files read, up to 40), so even ONE submission can
# consume a large share of the quota and a 32-competitor round exhausts it
# immediately — every later submission then degrades to a neutral AI score.
# A classic read-only Personal Access Token (no scopes needed for public repos)
# raises this to 5000/hour.
#   Create at: https://github.com/settings/tokens  (public_repo access only)
GITHUB_API_TOKEN=

# Email (Resend) — Epic E8
RESEND_API_KEY=
EMAIL_FROM=noreply@blitzit.example

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=

# Monitoring (Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─────────────── Tournament lifecycle & bracket engine (E3) ───────────────
# Deployment-wide defaults. Every one of these can be overridden per tournament
# in the database (Tournament.bracketSize / thirdPlaceEnabled / minRegistrations
# / maxRegistrations / roundDurations), so changing a tournament's shape never
# needs a redeploy.

# Force a bracket size: 8 | 16 | 32 | 64 (D6). Leave empty to size automatically
# from the qualified field — the largest supported bracket the field can fill.
TOURNAMENT_BRACKET_SIZE=
# Do the losing semi-finalists play off for third place?
TOURNAMENT_THIRD_PLACE_ENABLED=true
# Registrations required before a tournament may leave REGISTRATION_OPEN.
TOURNAMENT_MIN_REGISTRATIONS=8
# Hard cap on registrations. Further attempts are refused, not queued.
TOURNAMENT_MAX_REGISTRATIONS=512
# Simulation rounds feeding the seeding sum (D13: three).
TOURNAMENT_SIMULATION_ROUNDS=3
# When NEITHER competitor in a match submits before the deadline, advance the
# better seed rather than stalling the bracket. Set false to leave such matches
# undecided for an admin to resolve.
TOURNAMENT_ADVANCE_HIGHER_SEED_ON_NO_SHOW=true

# Evaluation runner
# Max concurrent evaluation jobs the in-process runner will claim.
RUNNER_CONCURRENCY=2
# How long a job may stay CLAIMED before it is treated as abandoned (crash /
# redeploy) and requeued. Must exceed the longest expected job duration.
RUNNER_CLAIM_TIMEOUT_MS=300000
# Set to "false" to disable the in-process runner (e.g. in CI).
RUNNER_ENABLED=true
