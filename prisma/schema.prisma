// Blitz It — Prisma schema (see docs/10-prisma-schema.md for rationale).
// Prisma 7: connection config lives in prisma.config.ts, NOT in the datasource block.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // Needed for the partial unique index on UserBadge (global badge awards).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// ─────────────────────────── Enums ───────────────────────────
enum Role {
  USER
  ADMIN
}

enum TournamentStatus {
  DRAFT
  // A published tournament is publicly visible but not yet accepting entries.
  // Splitting it out of DRAFT gives admins a review step before the schedule
  // goes live, and gives the spectator surface something to show early (E3).
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  SIMULATION
  SEEDING
  // The bracket exists and is inspectable, but no knockout round has opened.
  // Separating it from LIVE means bracket generation is a committed, auditable
  // step rather than a side effect of starting the first round (E3).
  BRACKET_GENERATED
  LIVE
  COMPLETED
  CANCELLED
}

/// Whether a tournament is listed on public surfaces. Orthogonal to
/// `TournamentStatus`, which describes the lifecycle phase (E5).
enum TournamentVisibility {
  PUBLIC
  UNLISTED
}

/// Which side of a match a feeder's outcome lands in. Persisted rather than
/// derived from `bracketPosition` parity so the topology is fully readable from
/// the database alone — the advancement engine never recomputes the tree.
enum MatchSlot {
  A
  B
}

enum RoundType {
  SIMULATION
  KNOCKOUT
}

enum RoundStage {
  SIMULATION
  R64
  R32
  R16
  QF
  SF
  THIRD_PLACE
  FINAL
  SUDDEN_DEATH
}

enum RoundStatus {
  PENDING
  OPEN
  JUDGING
  COMPLETED
}

enum MatchStatus {
  PENDING
  LIVE
  JUDGING
  DECIDED
}

enum WinReason {
  SCORE
  TIEBREAK_FUNCTIONAL
  TIEBREAK_TESTS
  TIEBREAK_TIME
  TIEBREAK_PERFORMANCE
  TIEBREAK_AI
  SUDDEN_DEATH
  BYE
  WALKOVER
  ADMIN
}

enum ChallengeCategory {
  REST_API
  WEB_APP
  AI_AGENT
  OCR
  AUTOMATION
  INTERNAL_TOOL
  CLI_APP
  CHROME_EXTENSION
}

enum ProblemVisibility {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  RECEIVED
  QUEUED
  JUDGING
  SCORED
  FAILED
  DISQUALIFIED
}

enum JobType {
  EVALUATE
  REEVALUATE
}

enum JobStatus {
  QUEUED
  CLAIMED
  RUNNING
  DONE
  FAILED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RegistrationStatus {
  ACTIVE
  REVOKED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  KYC_REQUIRED
  PROCESSING
  PAID
  FAILED
}

enum NotificationType {
  REGISTRATION_CONFIRMED
  SEEDED
  ROUND_OPEN
  MATCH_REMINDER
  RESULT
  ELIMINATED
  PAYOUT_SENT
  PRIZE_POOL_UPDATE
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

/// ───────────────── Better Auth (owned by the library) ─────────────────
/// These four models are required by Better Auth's Prisma adapter. They are
/// namespaced `Auth*` because our domain profile model is already called
/// `User`; the adapter is told the mapping via `modelName` in src/server/auth.ts.
/// Do not write to these directly — Better Auth owns them. Our domain `User`
/// links to `AuthUser` via `User.authUserId`.
model AuthUser {
  id            String            @id @default(cuid())
  name          String?
  email         String            @unique
  emailVerified Boolean           @default(false)
  image         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sessions      AuthSession[]
  accounts      AuthAccount[]

  @@map("auth_user")
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("auth_session")
}

model AuthAccount {
  id                    String    @id @default(cuid())
  userId                String
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_account")
}

model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verification")
}

/// ─────────────────────────── Identity ───────────────────────────
model User {
  id            String         @id @default(uuid())
  authUserId    String         @unique
  email         String         @unique
  username      String         @unique
  displayName   String?
  avatarUrl     String?
  city          String?
  country       String?        @default("IN")
  role          Role           @default(USER)
  profile       Profile?
  registrations Registration[]
  payments      Payment[]
  submissions   Submission[]
  rankings      Ranking[]
  payouts       Payout[]
  notifications Notification[]
  userBadges    UserBadge[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([city])
}

model Profile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio               String?
  githubUsername    String?
  websiteUrl        String?
  twitterHandle     String?
  preferredTimezone String?  @default("Asia/Kolkata")
  stats             Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// ─────────────────────────── Competition ───────────────────────────
model Tournament {
  id                        String           @id @default(uuid())
  slug                      String           @unique
  name                      String
  /// Operator-facing blurb shown on admin cards and (later) the public page.
  description               String?
  /// Whether the tournament is listed on public surfaces (E5).
  ///
  /// Distinct from `status`: status is the LIFECYCLE phase (is registration
  /// open? are we live?), visibility is whether anyone but an admin should see
  /// it at all. A rehearsal tournament runs the full lifecycle UNLISTED.
  visibility                TournamentVisibility @default(PUBLIC)
  /// Shelved by an admin. NOT a lifecycle state — archiving is a filing
  /// operation on a finished tournament, so it stays off the E3 state machine
  /// (which would otherwise need a new terminal state and new edges from every
  /// other one). Archived tournaments are hidden from the default admin list
  /// and are never resurrected into a different phase.
  archivedAt                DateTime?
  status                    TournamentStatus @default(DRAFT)
  /// Knockout stage currently in progress. Only meaningful while `status` is
  /// LIVE; together the pair forms the full lifecycle state (E3). Persisted so
  /// the engine can resume mid-bracket after a restart with no in-memory state.
  currentStage              RoundStage?
  passPriceMinor            Int              @default(10000)
  currency                  String           @default("INR")
  bracketSize               Int?
  /// Whether the losing semi-finalists play off for 3rd place (configurable).
  thirdPlaceEnabled         Boolean          @default(true)
  /// Registration limits (D6 sizing input). Null = fall back to configuration.
  minRegistrations          Int?
  maxRegistrations          Int?
  timezoneDisplay           String           @default("Asia/Kolkata")
  youtubeStreamUrl          String?
  // dynamic prize pool (D9/D12)
  participantCount          Int              @default(0)
  basePrizePoolMinor        Int              @default(0)
  prizePerRegistrationMinor Int              @default(10000)
  firstPrizeCapMinor        Int              @default(200000)
  prizePoolMinor            Int              @default(0)
  prizeDistribution         Json?
  // schedule (all UTC)
  registrationOpensAt       DateTime?
  registrationClosesAt      DateTime?
  simulationOpensAt         DateTime?
  simulationClosesAt        DateTime?
  liveStartsAt              DateTime?
  seededAt                  DateTime?
  bracketGeneratedAt        DateTime?
  completedAt               DateTime?
  cancelledAt               DateTime?
  cancellationReason        String?
  roundDurations            Json?
  // Stage -> evaluation profile overrides (D20). Null = built-in defaults:
  // deterministic through QF, AI enabled from SF/THIRD_PLACE/FINAL.
  evaluationProfiles        Json?
  createdBy                 String?
  rounds                    Round[]
  matches                   Match[]
  submissions               Submission[]
  registrations             Registration[]
  payments                  Payment[]
  rankings                  Ranking[]
  payouts                   Payout[]
  evaluations               Evaluation[]
  opsEvents                 OpsEvent[]
  hallOfFame                HallOfFame?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  @@index([status])
}

model Round {
  id              String       @id @default(uuid())
  tournamentId    String
  tournament      Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  type            RoundType
  stage           RoundStage
  sequence        Int
  status          RoundStatus  @default(PENDING)
  problemId       String?
  problem         Problem?     @relation(fields: [problemId], references: [id])
  opensAt         DateTime?
  deadlineAt      DateTime?
  durationSeconds Int
  matches         Match[]
  submissions     Submission[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([tournamentId, stage, sequence])
}

model Match {
  id              String      @id @default(uuid())
  roundId         String
  round           Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  tournamentId    String
  tournament      Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  bracketPosition Int
  competitorAId   String?
  competitorBId   String?
  /// Seeds occupying each slot. Kept alongside the competitor ids so the
  /// bracket reads correctly for byes (null competitor, null seed) and so the
  /// higher-seed fallback for a double no-show needs no extra lookup.
  seedA           Int?
  seedB           Int?
  submissionAId   String?     @unique
  submissionBId   String?     @unique
  winnerId        String?
  loserId         String?
  winReason       WinReason?
  status          MatchStatus @default(PENDING)
  /// Where the WINNER goes. Null only for the terminal match (FINAL / 3rd place).
  nextMatchId     String?
  nextMatch       Match?      @relation("Bracket", fields: [nextMatchId], references: [id])
  feederMatches   Match[]     @relation("Bracket")
  nextMatchSlot   MatchSlot?
  /// Where the LOSER goes — used only by the semi-finals when the third-place
  /// play-off is enabled. Everywhere else a loss is simply elimination.
  loserNextMatchId   String?
  loserNextMatch     Match?   @relation("BracketConsolation", fields: [loserNextMatchId], references: [id])
  loserFeederMatches Match[]  @relation("BracketConsolation")
  loserNextMatchSlot MatchSlot?
  /// Set when the win rule and every D5 tie-break failed to separate the two
  /// competitors. The match holds at JUDGING until a sudden-death challenge
  /// resolves it (D5.6 / D14, E6).
  tieUnresolved   Boolean     @default(false)
  /// A SUDDEN_DEATH match points back at the deadlocked match it exists to
  /// settle. When it is decided, its winner is written onto that match with
  /// `winReason = SUDDEN_DEATH` and advancement continues from there, so the
  /// main bracket topology never has to know sudden death happened (E6).
  resolvesMatchId String?     @unique
  resolvesMatch   Match?      @relation("SuddenDeath", fields: [resolvesMatchId], references: [id])
  suddenDeathMatch Match?     @relation("SuddenDeath")
  decidedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([roundId, bracketPosition])
  @@index([tournamentId])
  @@index([tournamentId, status])
}

model Problem {
  id                 String            @id @default(uuid())
  title              String
  slug               String            @unique
  statementMarkdown  String
  difficulty         String?
  category           ChallengeCategory
  evaluationStrategy String
  contractSpec       Json
  starterRepoUrl     String?
  visibility         ProblemVisibility @default(DRAFT)
  authorId           String?
  hiddenTests        HiddenTest[]
  rounds             Round[]
  submissions        Submission[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model HiddenTest {
  id        String   @id @default(uuid())
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  sequence  Int
  name      String
  kind      String
  spec      Json
  weight    Int      @default(1)
  timeoutMs Int      @default(10000)
  hidden    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([problemId, sequence])
}

/// ─────────────────────────── Submissions & evaluation ───────────────────────────
model Submission {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  tournamentId  String
  tournament    Tournament       @relation(fields: [tournamentId], references: [id])
  roundId       String
  round         Round            @relation(fields: [roundId], references: [id])
  matchId       String?
  problemId     String
  problem       Problem          @relation(fields: [problemId], references: [id])
  /// Challenge category this entry was accepted under (E4). Snapshotted from
  /// the Problem at submit time rather than joined on read: it is the category
  /// the submission was validated and scored against, and re-categorising a
  /// problem afterwards must not silently rewrite history.
  category      ChallengeCategory
  repoUrl       String
  deploymentUrl String
  commitSha     String?
  /// Current revision number. A competitor may replace their entry while the
  /// window is open; every accepted version is kept in `revisions` (E4).
  version       Int              @default(1)
  submittedAt   DateTime         @default(now())
  /// Set when the window closes. A sealed submission is immutable.
  sealedAt      DateTime?
  status        SubmissionStatus @default(RECEIVED)
  evaluation    Evaluation?
  revisions     SubmissionRevision[]
  jobs          EvaluationJob[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt @default(now())

  @@unique([userId, roundId])
  // Deployment-URL reuse detection (D19), enforced by the DATABASE.
  // The application also checks this to produce a friendly message, but that
  // check is read-then-write: two competitors submitting the same URL
  // concurrently would both see no clash and both insert. Only a constraint
  // actually prevents it. Sharing a deployment is precisely what the rule
  // exists to catch, so a disqualified entry still holds its URL.
  @@unique([roundId, deploymentUrl])
  @@index([tournamentId, status])
  @@index([userId, tournamentId])
}

/// Append-only history of every accepted version of a submission (E4).
///
/// `Submission` stays the ONE current entry per (user, round) — the unique key
/// the tournament engine reads through — and each edit made before the deadline
/// appends a row here. Doc 02 calls for append-only edits while the window is
/// open; keeping history in a sibling table delivers that without relaxing the
/// (userId, roundId) uniqueness that E3's advancement relies on.
model SubmissionRevision {
  id            String     @id @default(uuid())
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  version       Int
  repoUrl       String
  deploymentUrl String
  commitSha     String?
  /// Server time this version was accepted — the anti-cheat anchor (D19).
  submittedAt   DateTime   @default(now())
  createdAt     DateTime   @default(now())

  @@unique([submissionId, version])
  @@index([submissionId])
}

model Evaluation {
  id                       String     @id @default(uuid())
  submissionId             String     @unique
  submission               Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  tournamentId             String
  tournament               Tournament @relation(fields: [tournamentId], references: [id])
  attempt                  Int        @default(1)
  /// Which revision of the submission produced this score (E4). A competitor
  /// may replace their entry while an evaluation is in flight; recording the
  /// version makes a stale result detectable instead of silently authoritative.
  submissionVersion        Int        @default(1)
  functionalScore          Float      @default(0)
  testsPassed              Int        @default(0)
  testsTotal               Int        @default(0)
  testResults              Json?
  deploymentReachable      Boolean    @default(false)
  performanceScore         Float      @default(0)
  securityReliabilityScore Float      @default(0)
  aiScore                  Float      @default(0)
  overallScore             Float      @default(0)
  weights                  Json
  // Which profile governed this score, and which dimensions actually ran (D20).
  // Recorded so a past score can be explained without guessing the round rules.
  profileName              String?
  dimensions               Json?
  probeEvidence            Json?
  repoTextSnapshot         Json?
  rubricVersion            String?
  /// LLM backend that produced the AI dimension (D18). The engine already
  /// records it inside `llmRaw`; lifting it into its own column makes
  /// "which provider scored this round?" answerable without parsing JSONB.
  llmProvider              String?
  modelId                  String?
  modelPromptHash          String?
  llmRaw                   Json?
  startedAt                DateTime?
  finishedAt               DateTime?
  error                    String?
  overriddenBy             String?
  overrideReason           String?
  createdAt                DateTime   @default(now())
}

// Postgres-backed job substrate (D3). Generalized from the doc-10 "EvaluationJob"
// so it backs the provider-agnostic Queue interface for all job names (noop,
// evaluate, and later emails/payouts). submissionId is optional and denormalized
// (also carried in `payload`) to keep an FK for evaluation jobs. Claimed via
// SELECT ... FOR UPDATE SKIP LOCKED. Maps 1:1 onto a BullMQ job later.
model EvaluationJob {
  id             String      @id @default(uuid())
  name           String      @default("evaluate")
  payload        Json?
  submissionId   String?
  submission     Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  type           JobType     @default(EVALUATE)
  status         JobStatus   @default(QUEUED)
  attempts       Int         @default(0)
  maxAttempts    Int         @default(3)
  priority       Int         @default(0)
  claimedAt      DateTime?
  lockedBy       String?
  availableAt    DateTime    @default(now())
  lastError      String?
  idempotencyKey String      @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, availableAt])
}

/// ─────────────────────────── Ranking ───────────────────────────
model Ranking {
  id                String      @id @default(uuid())
  tournamentId      String
  tournament        Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  simulationScore   Float       @default(0)
  seed              Int?
  qualified         Boolean     @default(false)
  currentStage      RoundStage?
  eliminatedAtStage RoundStage?
  placement         Int?
  points            Int         @default(0)
  city              String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([tournamentId, userId])
  @@index([tournamentId, simulationScore(sort: Desc)])
  @@index([tournamentId, city])
}

/// ─────────────────────────── Payments ───────────────────────────
model Payment {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  tournamentId      String
  tournament        Tournament    @relation(fields: [tournamentId], references: [id])
  provider          String        @default("RAZORPAY")
  providerOrderId   String        @unique
  providerPaymentId String?       @unique
  amountMinor       Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  signatureVerified Boolean       @default(false)
  webhookEventId    String?       @unique
  paidAt            DateTime?
  refundedAt        DateTime?
  registration      Registration?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId, tournamentId])
}

model Registration {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  tournamentId String
  tournament   Tournament         @relation(fields: [tournamentId], references: [id])
  paymentId    String?            @unique
  payment      Payment?           @relation(fields: [paymentId], references: [id])
  status       RegistrationStatus @default(ACTIVE)
  registeredAt DateTime           @default(now())

  @@unique([userId, tournamentId])
}

model Payout {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  tournamentId     String
  tournament       Tournament   @relation(fields: [tournamentId], references: [id])
  placement        Int
  amountMinor      Int
  currency         String       @default("INR")
  provider         String       @default("RAZORPAYX")
  providerPayoutId String?      @unique
  status           PayoutStatus @default(PENDING)
  tdsMinor         Int          @default(0)
  taxMeta          Json?
  approvedBy       String?
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([tournamentId, userId])
}

/// ─────────────────────────── Engagement ───────────────────────────
model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  type      NotificationType
  channel   NotificationChannel @default(EMAIL)
  payload   Json?
  dedupeKey String              @unique
  status    NotificationStatus  @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, status])
}

model Badge {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  description String?
  iconUrl     String?
  criteria    Json?
  userBadges  UserBadge[]
  createdAt   DateTime    @default(now())
}

model UserBadge {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  badgeId      String
  badge        Badge    @relation(fields: [badgeId], references: [id])
  tournamentId String?
  awardedAt    DateTime @default(now())

  // Tournament-scoped awards: NULLs never collide here, so this covers only
  // rows where tournamentId IS NOT NULL.
  @@unique([userId, badgeId, tournamentId])
  // Global awards (tournamentId IS NULL): PostgreSQL treats NULLs as distinct,
  // so the constraint above would let the same global badge be awarded to a
  // user repeatedly. This partial unique index closes that hole.
  @@unique([userId, badgeId], where: { tournamentId: null }, name: "UserBadge_global_award_unique")
}

model HallOfFame {
  id            String     @id @default(uuid())
  tournamentId  String     @unique
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  championId    String
  runnerUpId    String?
  finalMatchId  String?
  highlightsUrl String?
  publishedAt   DateTime   @default(now())
}

/// ─────────────────────────── Admin & audit ───────────────────────────
model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  action        String
  entityType    String
  entityId      String
  before        Json?
  after         Json?
  ip            String?
  userAgent     String?
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
}

/// Scheduler + manual-ops trail. Every lifecycle transition is recorded here
/// BEFORE it is applied, keyed by a deterministic `idempotencyKey`, so a cron
/// replay or a double-click collapses onto the same event instead of running
/// the transition twice (E3.1/E3.2).
model OpsEvent {
  id             String     @id @default(uuid())
  type           String
  tournamentId   String
  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  scheduledFor   DateTime
  status         String     @default("SCHEDULED")
  idempotencyKey String     @unique
  runBy          String?
  payload        Json?
  result         Json?
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  /// Defaulted as well as @updatedAt so the column matches what the E3
  /// migration created. Without the default here Prisma reads the database as
  /// drifted and emits a DROP DEFAULT on the next migration.
  updatedAt      DateTime   @updatedAt @default(now())

  @@index([tournamentId, status])
  @@index([status, scheduledFor])
}
